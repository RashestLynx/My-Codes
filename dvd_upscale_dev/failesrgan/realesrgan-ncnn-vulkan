#!/usr/bin/env python3
"""Stand-in upscaler (plain resize) that fails once, like a GPU running out of memory, on every
chunk listed in FAIL_CHUNKS (e.g. "tmp_00004,tmp_00007"): writes half the frames, prints
vkAllocateMemory failed, exits 0 (as Real-ESRGAN does)."""
import os, subprocess, sys, time
args = sys.argv[1:]
opt = {args[i]: args[i + 1] for i in range(0, len(args) - 1, 2)}
src, dst, s = opt["-i"], opt["-o"], int(opt["-s"])
chunk = os.path.basename(os.path.dirname(os.path.abspath(dst)))
marker = os.path.join(os.path.dirname(os.path.abspath(dst)), "failed_once")
print("[0 FailGPU]  queueC=2[8]", flush=True)
time.sleep(1.5)
fail = chunk in os.environ.get("FAIL_CHUNKS", "").split(",") and not os.path.exists(marker)
frames = sorted(os.listdir(src))
pick = frames[:len(frames) // 2] if fail else frames
for name in pick:
    subprocess.run(["ffmpeg", "-v", "error", "-nostdin", "-y", "-i", os.path.join(src, name),
                    "-vf", f"scale=iw*{s}:ih*{s}:flags=bicubic", os.path.join(dst, name)], check=True)
if fail:
    open(marker, "w").close()
    print("[0 FailGPU] vkAllocateMemory failed -2", flush=True)
