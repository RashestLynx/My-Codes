#!/usr/bin/env python3
"""Stand-in upscaler (plain resize) whose GPU is reset, as on a Windows laptop where the
TDR watchdog fires: on frames wider than 300 pixels (so the start-up test on small pictures
passes), unless the tile size (-t) is at most RESET_TILE_MAX and the frames at once (-j x:N:x)
at most RESET_THREADS_MAX. After a reset it goes on as Real-ESRGAN does: one "vkQueueSubmit
failed -4" per piece of work, black frames, slowly, exit code 0. RESET_AFTER=N: the reset
comes after N good frames of each call (as on a laptop where it comes after a while). Each
call's -j and -t are appended to RESET_LOG."""
import os, struct, subprocess, sys, time
args = sys.argv[1:]
opt = {args[i]: args[i + 1] for i in range(0, len(args) - 1, 2)}
src, dst, s = opt["-i"], opt["-o"], int(opt["-s"])
threads = int(opt.get("-j", "1:2:2").split(":")[1])
tile = int(opt.get("-t", "0"))
frames = sorted(f for f in os.listdir(src) if f.endswith(".png"))
with open(os.path.join(src, frames[0]), "rb") as f:
    w = struct.unpack(">I", f.read(24)[16:20])[0]
if os.environ.get("RESET_LOG"):
    with open(os.environ["RESET_LOG"], "a") as f:
        f.write(f"w={w} threads={threads} tile={tile}\n")
print("[0 ResetGPU]  queueC=2[8]  queueG=0[16]  queueT=1[2]", flush=True)
tmax = int(os.environ.get("RESET_TILE_MAX", "0"))
jmax = int(os.environ.get("RESET_THREADS_MAX", "99"))
ok = w <= 300 or (0 < tile <= tmax and threads <= jmax)
if ok:
    r = subprocess.run(["ffmpeg", "-v", "error", "-nostdin", "-y", "-i",
                        os.path.join(src, "%06d.png"), "-vf",
                        f"scale=iw*{s}:ih*{s}:flags=bicubic", "-compression_level", "1",
                        os.path.join(dst, "%06d.png")])
    sys.exit(r.returncode)
after = int(os.environ.get("RESET_AFTER", "0"))
for name in frames[:after]:
    subprocess.run(["ffmpeg", "-v", "error", "-nostdin", "-y", "-i", os.path.join(src, name),
                    "-vf", f"scale=iw*{s}:ih*{s}:flags=bicubic", "-compression_level", "1",
                    os.path.join(dst, name)])
    print("50.00%\n100.00%", flush=True)
    time.sleep(float(os.environ.get("RESET_FRAME_SECS", "0.2")))
for name in frames[after:]:
    for _ in range(3):
        print("vkQueueSubmit failed -4", flush=True)
    subprocess.run(["ffmpeg", "-v", "error", "-nostdin", "-y", "-f", "lavfi", "-i",
                    f"color=black:s={w * s}x{w * s * 2 // 3}", "-frames:v", "1",
                    os.path.join(dst, name)])
    time.sleep(0.3)
